{
  "name": "procurement-triage",
  "version": "0.1.0",
  "private": true,
  "description": "Purchase-request triage: PDF intake, term extraction, policy routing and approvals on Postgres, with Lambda handlers and CDK infra.",
  "type": "module",
  "scripts": {
    "triage": "tsx src/cli.ts",
    "server": "tsx src/server.ts",
    "demo": "TRIAGE_STORE=memory npm run start",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "npm run build:web && tsx src/server.ts",
    "env:init": "node scripts/init-env.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down -v",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "db:seed": "tsx src/db-cli.ts seed",
    "samples:pdf": "tsx scripts/make-pdfs.ts data/sources data/samples",
    "eval": "tsx eval/run.ts",
    "eval:report": "tsx eval/report.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:record": "tsx scripts/record-demo.ts",
    "infra:test": "npm --prefix infra test",
    "infra:synth": "npm run bundle:lambda && npm --prefix infra run synth",
    "bundle:lambda": "node scripts/bundle-lambda.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build:web && npm run bundle:lambda"
  },
  "dependencies": {
    "pdfjs-dist": "^4.4.168",
    "pg": "^8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-ssm": "^3.600.0",
    "@types/aws-lambda": "^8.10.143",
    "@types/node": "20.14.10",
    "@types/pdfkit": "^0.13.4",
    "@types/pg": "^8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "esbuild": "^0.21.5",
    "pdfkit": "^0.15.0",
    "playwright-core": "^1.49.0",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vite": "5.3.3",
    "vitest": "2.0.5"
  }
}
